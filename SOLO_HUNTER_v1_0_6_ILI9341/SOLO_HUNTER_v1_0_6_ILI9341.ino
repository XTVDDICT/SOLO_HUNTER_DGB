void setupWebServer() {
  server.on("/", HTTP_GET, handleRoot);
  server.on("/save", HTTP_POST, handleSave);
  server.on("/clear-popup", HTTP_POST, handleClearPopup);
  server.on("/wifi", HTTP_POST, handleOpenWifiPortal);
  server.on("/status", HTTP_GET, handleStatusJson);
  server.begin();
}

void runWifiManagerPortal() {
  WiFiManager wm;
  portalMode = true;
  drawStaticLayout();
  statusText = "CONNECT TO SOLO_HUNTER_SETUP WIFI";
  drawValues();
  wm.setConfigPortalTimeout(180);
  bool connected = wm.autoConnect(AP_SSID, AP_PASS);

  if (!connected) {
    statusText = "WIFI PORTAL TIMEOUT";
    drawValues();
    return;
  }

  portalMode = false;
  statusText = cfgWallet.isEmpty() ? "NO WALLET CONFIG" : "LIVE " + WiFi.localIP().toString();
  drawValues();
}

// Keep display/network work on core 0, above the software helper, as in HELIOS.
static TaskHandle_t soloForegroundTaskHandle = nullptr;
static esp_pm_lock_handle_t soloMiningPowerLock = nullptr;
static esp_pm_lock_handle_t soloCpuFrequencyLock = nullptr;
void serviceSoloForeground();

void soloForegroundTask(void*) {
  for (;;) serviceSoloForeground();
}

void setup() {
  pinMode(TFT_BL, OUTPUT);
  digitalWrite(TFT_BL, HIGH);

  pinMode(REAR_LED, OUTPUT);
  rearLedOn();

  tft.init();
  loadPrefs();
  applyRotation();
  tft.setTextDatum(top_left);
  tft.fillScreen(C_BG);

  drawStaticLayout();
  statusText = "STARTING WIFI...";
  drawValues();

  if (WiFi.status() != WL_CONNECTED) {
    runWifiManagerPortal();
  }

  setupWebServer();

  if (WiFi.status() == WL_CONNECTED) {
    refreshWalletOnly();
    refreshFiatOnly();
    checkForMinedBlockAlert();
  }

  drawStaticLayout();
  drawValues();

  if (isBlockPopupVisible()) drawBlockPopup();

  lastWalletFetch = millis();
  lastFiatFetch = millis();
  lastMinedAlertCheck = millis();
  lastMiningDisplayRefresh = millis();

  WiFi.setSleep(false);
  if (esp_pm_lock_create(ESP_PM_NO_LIGHT_SLEEP, 0, "solo-miner",
                         &soloMiningPowerLock) == ESP_OK) {
    esp_pm_lock_acquire(soloMiningPowerLock);
  }
  if (esp_pm_lock_create(ESP_PM_CPU_FREQ_MAX, 0, "solo-cpu",
                         &soloCpuFrequencyLock) == ESP_OK) {
    esp_pm_lock_acquire(soloCpuFrequencyLock);
  }
  soloHunterMinerBegin(currentMiningEngineConfig());
  BaseType_t created = xTaskCreatePinnedToCore(
      soloForegroundTask, "solo-ui", 12288, nullptr, 2,
      &soloForegroundTaskHandle, 0);
  if (created != pdPASS) {
    soloForegroundTaskHandle = nullptr;
    // Share core 1 fairly with the miner if the foreground task cannot start.
    vTaskPrioritySet(nullptr, 2);
  }
}

void loop() {
  if (soloForegroundTaskHandle == nullptr) {
    serviceSoloForeground();
  } else {
    delay(1000);
  }
}

void serviceSoloForeground() {
  rearLedOn();
  server.handleClient();

  if (portalMode) {
    runWifiManagerPortal();
    drawStaticLayout();
    drawValues();
  }

  if (WiFi.status() != WL_CONNECTED) {
    delay(100);
    return;
  }

  if (popupActive) {
    if (!isBlockPopupVisible()) {
      clearBlockPopup();
    } else {
      delay(20);
      return;
    }
  }

  if (millis() - lastMiningDisplayRefresh >= MINING_DISPLAY_REFRESH_MS) {
    lastMiningDisplayRefresh = millis();
    drawMiningStats();
  }

  if (millis() - lastWalletFetch >= WALLET_REFRESH_MS) {
    lastWalletFetch = millis();
    refreshWalletOnly();
    drawValues();
  }

  if (millis() - lastFiatFetch >= FIAT_REFRESH_MS) {
    lastFiatFetch = millis();
    refreshFiatOnly();
    drawValues();
  }

  if (millis() - lastMinedAlertCheck >= MINED_ALERT_REFRESH_MS) {
    lastMinedAlertCheck = millis();
    checkForMinedBlockAlert();
    if (isBlockPopupVisible()) drawBlockPopup();
  }

  delay(20);
}
