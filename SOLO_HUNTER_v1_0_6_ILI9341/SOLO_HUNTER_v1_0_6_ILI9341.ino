}

String uint64Text(uint64_t value) {
  char text[24];
  snprintf(text, sizeof(text), "%llu", (unsigned long long)value);
  return String(text);
}

String formatMiningTotalHashes() {
  if (miningTotalHashes >= 1000000000ULL) {
    return fmtDecimals((float)miningTotalHashes / 1000000000.0f, 2) + "B";
  }
  if (miningTotalHashes >= 1000000ULL) {
    return fmtDecimals((float)miningTotalHashes / 1000000.0f, 2) + "M";
  }
  if (miningTotalHashes >= 1000ULL) {
    return fmtDecimals((float)miningTotalHashes / 1000.0f, 2) + "K";
  }
  return uint64Text(miningTotalHashes);
}

String formatMiningUptime() {
  uint32_t hours = miningUptimeSeconds / 3600U;
  uint32_t minutes = (miningUptimeSeconds / 60U) % 60U;
  uint32_t seconds = miningUptimeSeconds % 60U;
  char text[24];
  snprintf(text, sizeof(text), "%02lu:%02lu:%02lu",
           (unsigned long)hours, (unsigned long)minutes,
           (unsigned long)seconds);
  return String(text);
}

String formatMiningDiff() {
  if (miningBestDiff >= 1000000.0) return fmtDecimals((float)(miningBestDiff / 1000000.0), 2) + "M";
  if (miningBestDiff >= 1000.0) return fmtDecimals((float)(miningBestDiff / 1000.0), 2) + "K";
  if (miningBestDiff >= 1.0) return fmtDecimals((float)miningBestDiff, 2);
  if (miningBestDiff > 0.0) return fmtDecimals((float)miningBestDiff, 6);
  return fmtDecimals((float)miningBestDiff, 2);
}

String formatMiningDiffCompact() {
  if (miningBestDiff >= 1.0) return formatMiningDiff();
  if (miningBestDiff <= 0.0) return "0.00";
  if (miningBestDiff < 0.0001) return "<.0001";
  return fmtDecimals((float)miningBestDiff, 4);
}

