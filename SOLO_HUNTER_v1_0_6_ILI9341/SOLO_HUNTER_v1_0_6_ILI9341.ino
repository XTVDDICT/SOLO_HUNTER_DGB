float extractJsonFloat(const String& body, const char* key) {
  int pos = body.indexOf(key);
  if (pos < 0) return 0.0f;

  String sub = body.substring(pos + strlen(key));
  int comma = sub.indexOf(",");
  int brace = sub.indexOf("}");
  int end = comma;

  if (end < 0 || (brace >= 0 && brace < end)) end = brace;
  if (end > 0) sub = sub.substring(0, end);
  sub.trim();
  return sub.toFloat();
}

String compactJson(String body) {
  body.replace("\n", "");
  body.replace("\r", "");
  body.replace("\t", "");
  body.replace(" ", "");
  return body;
}

String extractJsonStringValue(const String& body, const char* key) {
  int pos = body.indexOf(key);
  if (pos < 0) return "";
  int start = pos + strlen(key);
  int end = body.indexOf("\"", start);
  if (end < 0 || end <= start) return "";
  return body.substring(start, end);
}

bool extractLatestMinedTx(const String& rawBody, String& txid, float& received) {
  String body = compactJson(rawBody);
  int typePos = body.indexOf("\"type\":\"mined\"");
  if (typePos < 0) return false;

  int objStart = body.lastIndexOf("{", typePos);
  int objEnd = body.indexOf("}", typePos);
  if (objStart < 0 || objEnd < 0 || objEnd <= objStart) return false;

  String obj = body.substring(objStart, objEnd + 1);
  txid = extractJsonStringValue(obj, "\"txid\":\"");
  received = extractJsonStringValue(obj, "\"received\":\"").toFloat();
  if (received <= 0.0f) received = extractJsonFloat(obj, "\"received\":");
  if (received <= 0.0f) received = extractJsonFloat(obj, "\"amount\":");
  if (received <= 0.0f) received = extractJsonFloat(obj, "\"value\":");
  return !txid.isEmpty();
}

