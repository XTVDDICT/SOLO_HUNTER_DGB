void drawValues() {
  tft.fillRect(20, 194, 280, 24, C_BG);
  tft.setTextSize(2);
  walletFiatValue = 0.0f;

  if (haveWalletData) {
    tft.setTextColor(C_GREEN, C_BG);
    tft.setCursor(24, 196);
    tft.print(fmt2(balanceDGB));

    String currencyCode = currentCurrencyCode();
    String fiatText = currentCurrencyWaitText();
    bool drawCustomPound = false;
    String fiatAmountText = "";
    if (haveFiatData) {
      walletFiatValue = currentWalletFiatValue();
      if (currencyCode == "GBP") {
        fiatAmountText = fmt2(walletFiatValue);
        drawCustomPound = true;
      } else {
        fiatText = currentFiatAmountText(walletFiatValue, 2);
      }
      tft.setTextColor(C_GREEN, C_BG);
    } else {
      tft.setTextColor(C_WARN, C_BG);
    }

    if (drawCustomPound) {
      const int poundWidth = 12;
      const int poundGap = 2;
      int amountX = 296 - tft.textWidth(fiatAmountText);
      int poundX = amountX - poundGap - poundWidth;

      if (poundX < 144) {
        poundX = 144;
        amountX = poundX + poundWidth + poundGap;
      }

      drawPoundGlyph2x(poundX, 196, C_GREEN, C_BG);
      tft.setCursor(amountX, 196);
      tft.print(fiatAmountText);
    } else {
      int fiatX = 296 - tft.textWidth(fiatText);
      if (fiatX < 144) fiatX = 144;
      tft.setCursor(fiatX, 196);
      tft.print(fiatText);
    }
  } else {
    if (WiFi.status() == WL_CONNECTED && cfgWallet.isEmpty()) {
      tft.setTextSize(1);
      tft.setTextColor(C_WARN, C_BG);
      tft.setCursor(24, 203);
      tft.print("CONNECT TO ");
      tft.setTextColor(C_GREEN, C_BG);
      tft.print(WiFi.localIP().toString());
    } else {
      tft.setTextColor(C_WARN, C_BG);
      tft.setCursor(24, 196);
      tft.print("NO DATA");
    }
  }

  tft.fillRect(78, 224, 222, 12, C_BG);
  tft.setTextSize(1);
  tft.setTextColor(statusText.startsWith("LIVE") ? C_GREEN : C_ALERT, C_BG);
  tft.setCursor(78, 226);
  tft.print(statusText);
  drawMiningStats();
}

