bool fetchDgbBalance() {
  if (WiFi.status() != WL_CONNECTED) {
    statusText = "BAL RETRY";
    return false;
  }

  if (cfgWallet.isEmpty()) {
    statusText = "NO WALLET CONFIG";
    return false;
  }

  WiFiClientSecure client;
  client.setInsecure();
  HTTPClient http;
  http.setConnectTimeout(5000);
  http.setTimeout(10000);
  http.setUserAgent("ESP32-SOLO-HUNTER/1.0.6");

  if (!http.begin(client, chainzUrl())) {
    statusText = "BAL RETRY";
    return false;
  }

  int code = http.GET();
  if (code != 200) {
    statusText = "BAL HTTP " + String(code);
    http.end();
    return false;
  }

  String body = http.getString();
  http.end();
  body.trim();

  if (!body.length() || body.startsWith("ERROR")) {
    statusText = "BAL RETRY";
    return false;
  }

  balanceDGB = body.toFloat();
  haveWalletData = true;
  return true;
}

bool fetchDgbFiatPrices() {
  if (WiFi.status() != WL_CONNECTED) {
    statusText = haveWalletData ? liveCurrencyWaitStatus() : currentCurrencyRetryText();
    return false;
  }

  WiFiClientSecure client;
  client.setInsecure();
  HTTPClient http;
  http.setConnectTimeout(5000);
  http.setTimeout(10000);
  http.setUserAgent("ESP32-SOLO-HUNTER/1.0.6");

  if (!http.begin(client, geckoUrl())) {
    statusText = haveWalletData ? liveCurrencyWaitStatus() : currentCurrencyRetryText();
    return false;
  }

  int code = http.GET();
  if (code == 429) {
    statusText = haveWalletData ? liveCurrencyWaitStatus() : currentCurrencyRetryText();
    http.end();
    return false;
  }
  if (code != 200) {
    statusText = haveWalletData ? liveCurrencyWaitStatus() : currentCurrencyCode() + " HTTP " + String(code);
    http.end();
    return false;
  }

  String body = http.getString();
  http.end();

  bool updated = false;
  float newUsd = extractJsonFloat(body, "\"usd\":");
  float newGbp = extractJsonFloat(body, "\"gbp\":");
  float newCad = extractJsonFloat(body, "\"cad\":");

  if (newUsd > 0.0f) {
    dgbPriceUsd = newUsd;
    updated = true;
  }
  if (newGbp > 0.0f) {
    dgbPriceGbp = newGbp;
    updated = true;
  }
  if (newCad > 0.0f) {
    dgbPriceCad = newCad;
    updated = true;
  }

  if (updated) {
    saveLastFiatPrices();
    syncFiatAvailability();
    return haveFiatData;
  }

  syncFiatAvailability();
  statusText = haveWalletData ? liveCurrencyWaitStatus() : currentCurrencyCode() + " PARSE FAIL";
  return false;
}

bool fetchLatestMinedTx(String& txid, float& received) {
  if (WiFi.status() != WL_CONNECTED || cfgWallet.isEmpty()) return false;

  WiFiClientSecure client;
  client.setInsecure();
  HTTPClient http;
  http.setConnectTimeout(5000);
  http.setTimeout(10000);
  http.setUserAgent("ESP32-SOLO-HUNTER/1.0.6");

  if (!http.begin(client, minedTxUrl())) return false;

  int code = http.GET();
  if (code != 200) {
    http.end();
    return false;
  }

  String body = http.getString();
  http.end();
  return extractLatestMinedTx(body, txid, received);
}

void checkForMinedBlockAlert() {
  if (WiFi.status() != WL_CONNECTED || cfgWallet.isEmpty()) return;

  String txid;
  float received = 0.0f;
  bool foundMinedTx = fetchLatestMinedTx(txid, received);

  if (!minedBaselineReady) {
    if (foundMinedTx) lastMinedTxId = txid;
    minedBaselineReady = true;
    saveMinedAlertState();
    return;
  }

  if (!foundMinedTx || txid.isEmpty() || txid == lastMinedTxId) return;

  lastMinedTxId = txid;
  if (received > 0.0f || !popupActive) {
    startBlockPopup(received);
  }
  saveMinedAlertState();
}

void refreshWalletOnly() {
  bool balOk = fetchDgbBalance();
  if (balOk) {
    statusText = "LIVE " + WiFi.localIP().toString();

    if (lastBalanceDGB < 0.0f) {
      lastBalanceDGB = balanceDGB;
      saveLastBalance();
    } else if (balanceDGB != lastBalanceDGB) {
      if (balanceDGB > lastBalanceDGB) {
        startBlockPopup(balanceDGB - lastBalanceDGB);
      }
      lastBalanceDGB = balanceDGB;
      saveLastBalance();
    }
  } else if (haveWalletData) {
    statusText = "LIVE / BAL RETRY";
  }
}

void refreshFiatOnly() {
  if (!haveWalletData || cfgWallet.isEmpty()) return;
  bool fiatOk = fetchDgbFiatPrices();
  if (fiatOk) {
    statusText = "LIVE " + WiFi.localIP().toString();
  } else if (haveWalletData && haveFiatData) {
    statusText = liveCurrencyWaitStatus();
  }
}

