  String saveSection = server.hasArg("section") ? server.arg("section") : "display";
  String oldWallet = cfgWallet;
  bool displaySave = (saveSection != "mining");

  if (displaySave) {
    if (server.hasArg("wallet")) cfgWallet = server.arg("wallet");
    if (server.hasArg("currency")) cfgCurrency = server.arg("currency");
    cfgFlip = server.hasArg("flip");
  } else {
    cfgMiningEnabled = server.hasArg("mining_enabled");
    if (server.hasArg("mine_host")) cfgMiningPoolHost = server.arg("mine_host");
    if (server.hasArg("mine_port")) cfgMiningPoolPort = server.arg("mine_port");
    if (server.hasArg("mine_user")) cfgMiningUser = server.arg("mine_user");
    if (server.hasArg("mine_worker")) cfgMiningWorker = server.arg("mine_worker");
    if (server.hasArg("mine_pass")) cfgMiningPass = server.arg("mine_pass");
  }

  trimConfig();
  bool walletChanged = (cfgWallet != oldWallet);

  if (displaySave && walletChanged) {
    haveWalletData = false;
    popupActive = false;
    popupPersistent = false;
    popupUntil = 0;
    deltaDGB = 0.0f;
    lastBalanceDGB = -1.0f;
    lastMinedTxId = "";
    minedBaselineReady = false;
  }

  syncFiatAvailability();
  savePrefs();
  if (!displaySave) soloHunterMinerConfigure(currentMiningEngineConfig());
  applyRotation();

  if (displaySave && WiFi.status() == WL_CONNECTED) {
    refreshWalletOnly();
    refreshFiatOnly();
    checkForMinedBlockAlert();
  }

  drawStaticLayout();
  drawValues();
  lastWalletFetch = millis();
  lastFiatFetch = millis();
  lastMinedAlertCheck = millis();

  server.sendHeader("Location", displaySave ? "/" : "/#mining", true);
  server.send(303, "text/plain", "");
}

